@startuml usecase
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}

actor User

rectangle "COLORS Web Application" {
  usecase "Login" as UC1
  usecase "Authenticate User" as UC2
  usecase "Add Color" as UC3
  usecase "Search Colors" as UC4
  usecase "View Color Results" as UC5
  usecase "Logout" as UC6
}

User --> UC1
User --> UC3
User --> UC4
User --> UC6

UC1 ..> UC2 : <<include>>
UC4 ..> UC5 : <<include>>

@enduml
